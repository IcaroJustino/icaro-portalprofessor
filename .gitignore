# Arquivo .gitignore para projeto com /frontend (Node + Vite) e /backend (Spring Boot)

# Arquivos do sistema
.DS_Store
Thumbs.db
desktop.ini

# IDEs / editores
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Logs e temporários
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp
tmp/
temp/

# Frontend (Node + Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.parcel-cache/
frontend/.env
frontend/.env.*
frontend/.cache/

# Backend (Spring Boot - Maven / Gradle)
backend/target/
backend/build/
backend/*.class
backend/*.jar
backend/*.war
backend/*.log
backend/.gradle/
backend/.mvn/wrapper/maven-wrapper.jar  # se preferir versionar o wrapper remova esta linha

# Dependências locais / caches
node_modules/
coverage/
.cache/

# Arquivos sensíveis
.env
.env.local
.env.*.local

# Outros
*.swp
*.swo